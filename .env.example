# ========================================================
# Pinnacle University (Pinnacle_U) - Environment Configuration
# ========================================================

# 1. Supabase PostgreSQL Connection String (Prisma ORM)
# Transaction mode (Connection Pooler, Port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct connection (Session mode, Port 5432) - for migrations/push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. Resend API Configuration (for Email OTPs)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_123456789_placeholder"
RESEND_FROM_EMAIL="Pinnacle University <onboarding@resend.dev>"

# 3. Backend Server & Security
PORT=5000
NODE_ENV="development"
JWT_SECRET="pinnacle-u-super-secret-jwt-key-2024"
CORS_ORIGIN="*"

# 4. Frontend API Endpoint (Vite)
# In development, Vite proxies /api to http://localhost:5000
# In Vercel production, set this to your Render backend URL (e.g., https://pinnacle-u-api.onrender.com/api)
VITE_API_URL="/api"
