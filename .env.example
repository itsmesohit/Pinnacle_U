# ========================================================
# Pinnacle University (Pinnacle_U) - Environment Configuration
# ========================================================

# 1. Supabase PostgreSQL Connection String (Prisma ORM)
# Transaction mode (Connection Pooler, Port 6543) - Recommended for IPv4/Serverless
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Session mode, Port 5432) - For migrations/push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Resend API Configuration (for Email OTPs)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
# Must use a verified domain configured in Resend (e.g. auth@yourdomain.com)
RESEND_FROM_EMAIL="Pinnacle University <auth@yourdomain.com>"

# 3. Backend Server & Security
PORT=5001
NODE_ENV="development"
JWT_SECRET="pinnacle-u-super-secret-jwt-key-change-in-production"
CORS_ORIGIN="*"

# 4. Frontend API Endpoint (Vite)
# In development, Vite proxies /api to http://localhost:5001
# In Vercel production, set this to your Render backend URL (e.g., https://your-backend.onrender.com/api)
VITE_API_URL="/api"
